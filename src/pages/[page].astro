---
import Base from '../layouts/Base.astro';
const pages = {
 contact: {title:'LET’S TALK FRAGRANCE.', intro:'Explore the collection and prepare an inquiry about your favorite fragrances.', sections:[{heading:'Product inquiries',body:'Choose a fragrance and size on its product page, or start a general inquiry. You can include your destination, quantity and preferred quote currency.'},{heading:'Contact availability',body:'Inquiry delivery is not connected in this preview. The inquiry page lets you download a draft to your device; no message is sent. Direct contact details will be added when available.'}],link:true},
 faq: {title:'A LITTLE MORE TO KNOW.',intro:'Your fragrance questions, answered.',sections:[{heading:'Can I purchase on this website?',body:'This is an inquiry-only catalog. There is no checkout or online payment. Browse fragrances and prepare an inquiry about the products you are interested in.'},{heading:'Why are prices shown as “Request a quote”?',body:'Prices have not yet been published. You can choose US dollars or euros as your preferred quote currency. Changing currency does not create a price or convert an amount.'},{heading:'How do I choose a size?',body:'Select a format on the fragrance detail page. Your selection is carried into the inquiry form, where you can also specify a quantity.'},{heading:'Has my inquiry been sent?',body:'Not in this preview. The form downloads a text draft to your device. Delivery will become available after a receiving channel is connected.'},{heading:'Where can products be delivered?',body:'The site is intended for customers in Europe and North America. Actual destination availability, shipping costs and delivery times must be confirmed with a quote.'}],link:true},
 privacy: {title:'PRIVACY NOTICE',intro:'This notice describes the current local preview, not a live inquiry service.',sections:[{heading:'Your inquiry information',body:'The preview form does not transmit your name, email or message. Downloading an inquiry draft creates a text file on your device. Form contents are not saved to local storage by this site.'},{heading:'Currency preference',body:'Your preferred currency may be stored in your browser so it remains selected between pages. You can remove it by clearing this site’s browser data.'},{heading:'Analytics and external services',body:'This preview does not include advertising pixels, analytics scripts or the reference website’s third-party integrations. Image assets are served locally.'},{heading:'Before inquiry delivery is enabled',body:'The operator’s contact details, chosen delivery provider, retention period and applicable privacy information must be published before collecting and transmitting inquiries.'}],link:false},
 terms: {title:'WEBSITE TERMS',intro:'Information for using this inquiry catalog preview.',sections:[{heading:'Catalog information',body:'Product images and names are presented for browsing and inquiry preparation. Displayed formats are reference information and do not confirm stock, supply, pricing or delivery availability.'},{heading:'No online orders',body:'An inquiry draft is not an order, payment, reservation or offer acceptance. All commercial details must be confirmed separately.'},{heading:'Preview status',body:'This site is under development. Inquiry delivery is not active. Final operating details and terms will be published before launch.'}],link:false},
};
export function getStaticPaths(){return ['contact','faq','privacy','terms'].map(page=>({params:{page}}));}
const content=pages[Astro.params.page as keyof typeof pages];
---
<Base title={content.title}><article class="content-page"><p class="eyebrow">ELLIS BROOKLYN</p><h1>{content.title}</h1><p>{content.intro}</p>{content.sections.map(section=><section><h2>{section.heading}</h2><p>{section.body}</p></section>)}{content.link&&<a href="/inquiry" class="button dark">Prepare an inquiry ↗</a>}</article></Base>
